APP_NAME=Laravel
# Élesben KIZÁRÓLAG APP_ENV=production (pontos érték) kapcsolja be a prod-hardeninget
# (CSP/HSTS, Secure-cookie, erős jelszó-policy, destruktív-parancs tiltás). Ismeretlen
# érték (pl. "prod") a bootot leállítja — lásd AppServiceProvider::assertKnownEnvironment.
APP_ENV=local
APP_KEY=
# Élesben KÖTELEZŐEN APP_DEBUG=false (a prod boot leáll, ha true).
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# Élesben LOG_STACK=daily ajánlott (14 napos retenció, forgatott fájlok) —
# a single csatorna sosem forgatott laravel.log-ot ír, ami korlátlanul nő.
LOG_STACK=single
# LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Élesben (APP_ENV=production) automatikusan true; lokális HTTP-hez hagyd üresen/false-on.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# A failed-job és error-log riasztások címzettje. Élesben KÖTELEZŐEN kitöltendő —
# üresen a MonitorFailedJobs riasztás csendben elmarad (observability-vakfolt).
ADMIN_EMAIL=

# Google Gemini API kulcs az AI szó-lookuphoz/flashcardhoz. Élesben kötelező —
# üresen minden AI-hívás hibára/kör-megszakítóra fut.
GEMINI_API_KEY=

# Sanctum player-token prefix. Beállítva a kiadott tokenek felismerhetők, így a
# git-hoster secret-scanning jelezni tudja, ha egy token véletlenül repóba/logba kerül.
SANCTUM_TOKEN_PREFIX=tpw_

# Új fiók regisztrációja engedélyezve van-e (alapértelmezés: true).
# false esetén a Fortify a szerveroldalon egyáltalán nem regisztrálja a
# register route-ot — a regisztráció teljesen le van tiltva.
# REGISTRATION_ENABLED=true
# Ha true, a regisztrációhoz érvényes meghívókód kell (a fenti kapcsoló mellett).
# REGISTRATION_INVITE_ONLY=false

# A Chrome bővítmény publikus Chrome Web Store-linkje. Amíg üres, a
# dashboard-banner és a sidebar „hamarosan" állapotot mutat; beállítva
# mindkettő a store-listingre visz. A fejlesztői .zip ettől függetlenül
# végig elérhető adminként a /downloads oldalon.
# CHROME_WEB_STORE_URL=https://chromewebstore.google.com/detail/<extension-id>

STRIPE_ENABLED=false
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
CASHIER_CURRENCY=huf
CASHIER_CURRENCY_LOCALE=hu_HU

# Ingyenes próbaidőszak napokban (0 = nincs trial)
SUBSCRIPTION_TRIAL_DAYS=0

# NAV-számlázás (Billingo v3) — a Stripe-webhookra fut
BILLINGO_ENABLED=false
BILLINGO_API_KEY=
BILLINGO_BLOCK_ID=0          # 0 = automatikusan az első számlatömb
BILLINGO_VAT=AAM             # alanyi adómentes; ÁFA-körnél pl. "27%"
BILLINGO_ITEM_NAME="topEwords előfizetés"
