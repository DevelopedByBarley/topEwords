{
    "manifest_version": 3,
    "name": "TopWords",
    "version": "1.20",
    "description": "Look up English words instantly on any webpage, on YouTube and Netflix subtitles, and track your vocabulary progress with spaced repetition.",
    "homepage_url": "https://topwords.eu",
    "minimum_chrome_version": "110",
    "permissions": ["activeTab", "contextMenus", "storage"],
    "host_permissions": ["https://topwords.eu/*"],
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_title": "TopWords",
        "default_icon": {
            "16": "icon16.png",
            "48": "icon48.png",
            "128": "icon128.png"
        },
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": [
                "src/shared.js",
                "src/styles.js",
                "src/tokenizer.js",
                "src/lookup-popup.js",
                "src/search-modal.js",
                "src/flashcard-modal.js",
                "src/page-highlight.js"
            ],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.youtube.com/*"],
            "js": ["src/youtube.js"],
            "run_at": "document_idle"
        },
        {
            "matches": ["https://www.netflix.com/*"],
            "js": ["src/youtube.js", "src/netflix.js"],
            "run_at": "document_idle"
        }
    ]
}
